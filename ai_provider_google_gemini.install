<?php

/**
 * Implements hook_install().
 */
function ai_provider_google_gemini_install() {
  if (!module_load_install('ai_upgrade')) { return []; }
  ai_upgrade_module_install('ai_provider_google_gemini');
}

/**
 * Copy legacy Google Gemini provider configuration into the AI namespace.
 *
 * Non-destructive: legacy config is kept and the legacy module stays enabled
 * until the operator completes the cutover with AI Upgrade.
 */
function ai_provider_google_gemini_update_1000() {
  if (!module_load_install('ai_upgrade')) {
    return t('AI Upgrade helpers unavailable; legacy Google Gemini provider configuration not migrated.');
  }
  $result = ai_upgrade_module_install('ai_provider_google_gemini');
  return t('Copied @count legacy Google Gemini provider config object(s).', ['@count' => $result['migrated']]);
}

/**
 * Implements hook_requirements().
 */
function ai_provider_google_gemini_requirements($phase) {
  if (!module_load_install('ai_upgrade')) { return []; }
  return ai_upgrade_module_requirements($phase, 'ai_provider_google_gemini');
}
